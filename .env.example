# ==============================================================================
# TELEGRAM UMRAH CONTENT AGENT — KONFIGURATSIYA NAMUNASI (.env.example)
# ==============================================================================
# Eslatma: Ushbu fayldan nusxa olib, nomini `.env` deb o'zgartiring va o'z kalitlaringizni kiriting.
# Hech qachon haqiqiy `.env` faylini GitHub yoki ommaviy repozitoriyga yuklamang!

# ------------------------------------------------------------------------------
# 1. TELEGRAM BOSHQARUV BOTI VA MAQSADLI KANAL
# ------------------------------------------------------------------------------
# @BotFather orqali yaratilgan bot tokeni:
BOT_TOKEN=1234567890:ABCDefGhIJKlmNoPQRsTUVwxyZ_1234567

# Administratorlarning Telegram ID raqamlari (faqat ushbu ID egalari botni boshqara oladi):
ADMIN_IDS=123456789,987654321

# Muhtasham Travel Telegram kanali username yoki identifikatori:
TARGET_CHANNEL=@muhtashamtraveluzz

# ------------------------------------------------------------------------------
# 2. MA'LUMOTLAR BAZASI (POSTGRESQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_muhtasham_password_2026
POSTGRES_DB=muhtasham_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:secure_muhtasham_password_2026@localhost:5432/muhtasham_db

# ------------------------------------------------------------------------------
# 3. AI MODELI (GOOGLE GEMINI YOKI OPENAI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere123456789
AI_MODEL_NAME=gemini-1.5-flash
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 4. NASHR JADVALI VA LIMITLAR (ASIA/TASHKENT)
# ------------------------------------------------------------------------------
TIMEZONE=Asia/Tashkent

# Kunlik maqsad: 20–50 ta post (kun davomida teng taqsimlanadi):
DAILY_POST_MIN=20
DAILY_POST_MAX=50

# Nashr oynasi (Toshkent vaqti bilan):
PUBLISH_START_HOUR=7
PUBLISH_END_HOUR=23

# Kunlik hisobot soatlari:
REPORT_HOURS=8,13,20

# ------------------------------------------------------------------------------
# 5. TELEGRAM MTPROTO (TELETHON) — MANBALAR KUZATUVI UCHUN (IXTIYORIY)
# ------------------------------------------------------------------------------
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELETHON_SESSION_STRING=

# ------------------------------------------------------------------------------
# 6. SAQLASH VA LOGLAR
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
MEDIA_TEMP_DIR=./temp_media
PHASH_THRESHOLD=5
SEMANTIC_THRESHOLD=0.75
